# 비워 두면 로컬 내장 DB(.data/pglite)를 쓴다. 배포 시 Supabase 연결 문자열.
DATABASE_URL=
# 세션 쿠키 서명용. 배포 시 32자 이상 무작위 문자열로 바꿀 것.
SESSION_SECRET=
# 예약 실행(/api/cron/*) 호출용.
CRON_SECRET=
# 공공데이터포털 여객기 운항 현황 상세 조회 서비스 디코딩 키.
ICN_API_KEY=
# mock | live. live 는 기관 개인정보 검토가 끝난 뒤에만.
DATA_MODE=mock
# 패스 QR 에 들어갈 주소.
BASE_URL=http://localhost:3000

# 선택: 독립된 로컬 검증 DB 경로. 비워 두면 기존 .data/pglite 사용.
JSP_LOCAL_DB_DIR=
# 선택: 직원이 명시적으로 켜는 브라우저 푸시. 세 값이 없으면 화면 내 알림만 사용.
# 공개 키는 브라우저로 전달되며 비공개 키는 서버 환경에만 둔다.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
